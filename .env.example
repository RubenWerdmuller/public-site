# Leave DATABASE_URL empty for local, persistent PostgreSQL via PGlite.
DATABASE_URL=
APP_URL=http://localhost:3100
CRON_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AI administrators: existing app login email addresses, comma separated. Empty disables access.
AI_ADMIN_EMAILS=
# Generate a separate random secret and configure the same value in Vercel and GitHub Actions.
AI_PIPELINE_SECRET=
AI_GITHUB_REPOSITORY=RubenWerdmuller/public-site
# OPENAI_API_KEY belongs in GitHub Actions secrets, not in this frontend environment.
